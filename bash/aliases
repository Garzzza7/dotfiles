# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias bsh='$HOME/.local/share/nvim/mason/bin/shfmt -s -w *.sh'
alias gf2='$HOME/gf/gf2'
alias mc='EDITOR=nvim mc'
# alias emacs='emacs --no-window-system'
alias nv='nvim'
alias vimu='vim -u NONE'
alias :q='exit'
alias lg='lazygit'
alias du='du -h'
alias gs='git status'
alias ga='git add'
alias gp='git push'
alias gu='git pull --recurse-submodules'
alias gc='git commit'
alias pp='powerprofilesctl set performance'
alias pb='powerprofilesctl set balanced'
alias pps='powerprofilesctl set power-saver'
alias rm='trash-put'
alias suspend='systemctl suspend'
alias ..='cd ..'
alias vi='vim'
alias pls='sudo $(history -p !!)'

export PATH=$PATH:$HOME/.local/share/nvim/mason/bin
export PATH=$PATH:~/scripts
